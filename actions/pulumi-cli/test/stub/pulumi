#!/usr/bin/env bash
#
# Fake 'pulumi' CLI for run-tests.sh, placed ahead of any real pulumi on $PATH so
# the action scripts run unmodified with no credentials, backend or network.
#
# Knobs:
#   STUB_LOG              file to append "<basename of cwd><TAB><argv>" per call
#   STUB_FAIL_CMDS        subcommands that must fail, e.g. "up" or "preview
#                         refresh". 'stack select'/'stack init' are keyed as
#                         "stack-select"/"stack-init"
#   STUB_FAIL_IN_DIR      restrict STUB_FAIL_CMDS to the workdir with this basename
#   STUB_NO_STACK         'stack select' fails, forcing 'stack init'
#   STUB_FAIL_INIT        'stack init' fails too
#   STUB_DRIFT            preview emits pulumi's "Note: Objects have changed" line
#   STUB_DRIFT_IN_DIR     restrict STUB_DRIFT to the workdir with this basename
#   STUB_PREVIEW_MARKER   'none' omits the "Pulumi used the selected providers" line
#   STUB_PREVIEW_EXTRA    an extra line injected into preview output
#   STUB_LOGIN_ERROR      text for a realistic 'pulumi login' failure, e.g. an
#                         unassumable role. Implies login fails.
#   STUB_WRAPPED_ERROR    cause text for a failure in STUB_FAIL_CMDS, reported in
#                         pulumi's real diagnostic shape: a generic wrapper 'error:'
#                         line, the causes indented and bulleted below it, and a second
#                         wrapper line last. Replaces the flat one-line failure.
#                         '|'-separated for several causes under the one wrapper.
#   STUB_BARE_ERROR       like STUB_WRAPPED_ERROR but with no wrapper above the cause,
#                         only the trailing 'error: <cmd> failed' summary below it
set -uo pipefail

cmd="${1:-}"
sub="${2:-}"
cwd_name="$(basename "$PWD")"

if [[ "$cmd" == "stack" ]]; then
  key="stack-${sub}"
else
  key="$cmd"
fi

if [[ -n "${STUB_LOG:-}" ]]; then
  printf '%s\t%s\n' "$cwd_name" "$*" >> "$STUB_LOG"
fi

in_list() {
  local needle="$1" list="$2"
  case " ${list} " in
    *" ${needle} "*) return 0 ;;
    *) return 1 ;;
  esac
}

should_fail() {
  in_list "$key" "${STUB_FAIL_CMDS:-}" || return 1
  if [[ -n "${STUB_FAIL_IN_DIR:-}" && "$cwd_name" != "${STUB_FAIL_IN_DIR}" ]]; then
    return 1
  fi
  return 0
}

should_drift() {
  [[ -n "${STUB_DRIFT:-}" ]] || return 1
  if [[ -n "${STUB_DRIFT_IN_DIR:-}" && "$cwd_name" != "${STUB_DRIFT_IN_DIR}" ]]; then
    return 1
  fi
  return 0
}

# Output comes first, then the failure, so tests can assert the *.out artifacts
# survive a failed run.
case "$key" in
  login)
    if [[ -n "${STUB_LOGIN_ERROR:-}" ]]; then
      # Two lines, so tests prove the 'error:' line is picked over the last line.
      echo "warning: could not read the state bucket" >&2
      echo "error: ${STUB_LOGIN_ERROR}" >&2
      echo "note: run 'pulumi login --help' for more information" >&2
      exit 255
    fi
    echo "Logged in to stub-backend as tester"
    ;;
  stack-select)
    if [[ -n "${STUB_NO_STACK:-}" ]]; then
      echo "error: no stack named 'main' found" >&2
      exit 1
    fi
    ;;
  stack-init)
    if [[ -n "${STUB_FAIL_INIT:-}" ]]; then
      echo "error: could not create stack 'main'" >&2
      exit 1
    fi
    echo "Created stack 'main'"
    ;;
  refresh)
    echo "Refreshing (main):"
    echo "STUB-REFRESH-OUTPUT"
    ;;
  preview)
    echo "Previewing update (main):"
    echo "STUB-PREVIEW-PREAMBLE"
    if should_drift; then
      echo "Note: Objects have changed outside of Pulumi"
    fi
    if [[ "${STUB_PREVIEW_MARKER:-}" != "none" ]]; then
      echo "Pulumi used the selected providers to generate the following update:"
    fi
    echo "    + aws:s3:Bucket example create"
    if [[ -n "${STUB_PREVIEW_EXTRA:-}" ]]; then
      echo "    ${STUB_PREVIEW_EXTRA}"
    fi
    echo "Resources:"
    echo "    + 1 to create"
    ;;
  up)
    echo "Updating (main):"
    echo "STUB-UP-OUTPUT"
    ;;
  destroy)
    echo "Destroying (main):"
    echo "STUB-DESTROY-OUTPUT"
    ;;
  *)
    echo "stub pulumi: unhandled subcommand '$*'" >&2
    exit 127
    ;;
esac

if should_fail; then
  # Pulumi names the operation, not the subcommand, in its trailing summary line:
  # 'pulumi up' fails with 'error: update failed'.
  case "$key" in
    up) phase="update" ;;
    *) phase="$key" ;;
  esac
  if [[ -n "${STUB_WRAPPED_ERROR:-}" ]]; then
    IFS='|' read -r -a causes <<< "${STUB_WRAPPED_ERROR}"
    {
      echo "Diagnostics:"
      echo "  pulumi:pulumi:Stack (example-main):"
      if (( ${#causes[@]} == 1 )); then
        echo "    error: Preview failed: 1 error occurred:"
      else
        echo "    error: Preview failed: ${#causes[@]} errors occurred:"
      fi
      for cause in "${causes[@]}"; do
        printf '    \t* %s\n' "$cause"
      done
      echo ""
      echo "error: ${phase} failed"
    } >&2
    exit 255
  fi
  if [[ -n "${STUB_BARE_ERROR:-}" ]]; then
    {
      echo "    ${STUB_BARE_ERROR}"
      echo ""
      echo "error: ${phase} failed"
    } >&2
    exit 255
  fi
  echo "error: simulated ${key} failure in ${cwd_name}" >&2
  exit 1
fi

exit 0
